<%- include('partials/header') %>
<div class="top-bar">
  <h1><i data-lucide="clock"></i> Horarios de Disponibilidad</h1>
</div>

<div class="controls-bar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
  <!-- Filtro rápido por empleado -->
  <div style="display: flex; gap: 12px; align-items: center;">
    <label style="color: var(--text-muted); font-size: 0.9rem;"><i data-lucide="filter" style="width:16px;"></i> Filtrar:</label>
    <select id="filter-empleado" class="input-modern" style="padding: 8px 16px; border-radius: 8px; border: 1px solid rgba(128,128,128,0.2); background: var(--surface); color: var(--text);" onchange="filtrarHorarios()">
      <option value="ALL">Todos los empleados</option>
      <% empleados.forEach(e => { %>
      <option value="<%= e.nombre %>"><%= e.nombre %></option>
      <% }) %>
    </select>
  </div>

  <button class="btn btn-primary" onclick="document.getElementById('form-horario').classList.toggle('visible')">
    <i data-lucide="calendar-plus"></i> Asignar Horario
  </button>
</div>

<div id="form-horario" class="expandable-form" style="display: none; background: var(--surface); padding: 24px; border-radius: 12px; border: 1px solid rgba(128,128,128,0.2); margin-bottom: 32px;">
  <h3 style="margin-bottom: 16px; border-bottom: 1px solid rgba(128,128,128,0.2); padding-bottom: 8px;">Nueva Asignación</h3>
  <form method="POST" action="/empleados/horarios" class="form-grid" style="box-shadow: none; border: none; padding: 0; margin: 0; background: transparent;">
    <div class="field"><label>Empleado *</label>
      <select name="id_empleado" required>
        <option value="">—</option>
        <% empleados.forEach(e => { %>
        <option value="<%= e.id %>"><%= e.nombre %></option>
        <% }) %>
      </select>
    </div>
    <div class="field"><label>Día *</label>
      <select name="dia_semana" required>
        <% dias.forEach((d, i) => { %>
        <option value="<%= i + 1 %>"><%= d %></option>
        <% }) %>
      </select>
    </div>
    <div class="field"><label>Hora inicio *</label><input name="hora_inicio" type="time" required></div>
    <div class="field"><label>Hora fin *</label><input name="hora_fin" type="time" required></div>
    
    <div class="field" style="align-self:end; display:flex; gap:8px;">
      <button type="button" class="btn" style="background:transparent; border:1px solid var(--text-muted); color:var(--text);" onclick="document.getElementById('form-horario').classList.remove('visible')">Cancelar</button>
      <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Guardar</button>
    </div>
  </form>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
  <% if (horarios.length === 0) { %>
    <div class="empty" style="grid-column: 1 / -1; padding: 48px; background: var(--surface); border-radius: 12px; border: 1px solid rgba(128,128,128,0.2);">Sin horarios registrados</div>
  <% } %>
  
  <% horarios.forEach(h => { %>
    <div class="horario-card" data-empleado="<%= h.empleado %>" style="background: var(--surface); border-radius: 12px; border: 1px solid rgba(128,128,128,0.2); overflow: hidden; display: flex; flex-direction: column;">
      <div style="padding: 16px; background: rgba(128,128,128,0.05); border-bottom: 1px solid rgba(128,128,128,0.1); display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(h.empleado) %>&background=random&color=fff&size=40" alt="Avatar" style="border-radius: 50%; width: 40px; height: 40px;">
          <div>
            <h4 style="margin: 0; color: var(--primary); font-size: 1.05rem;"><%= h.empleado %></h4>
            <span style="font-size: 0.8rem; color: var(--text-muted);"><%= h.especialidad || 'Sin especialidad' %></span>
          </div>
        </div>
        <span class="badge badge-<%= h.activo %>" style="font-size: 0.7rem;"><%= h.activo ? 'Activo' : 'Inactivo' %></span>
      </div>
      
      <div style="padding: 16px; flex: 1; display: flex; flex-direction: column; gap: 12px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <strong style="font-size: 1.1rem; display: flex; align-items: center; gap: 6px;"><i data-lucide="calendar" style="width: 16px; color: var(--primary);"></i> <%= dias[h.dia_semana - 1] %></strong>
        </div>
        
        <div style="display: flex; gap: 12px; background: var(--bg); padding: 12px; border-radius: 8px; border: 1px solid rgba(128,128,128,0.1); align-items: center; justify-content: center;">
          <span style="font-size: 1.1rem; font-weight: 500;"><%= h.hora_inicio %></span>
          <i data-lucide="arrow-right" style="width: 16px; color: var(--text-muted);"></i>
          <span style="font-size: 1.1rem; font-weight: 500;"><%= h.hora_fin %></span>
        </div>
      </div>
      
      <div style="padding: 12px 16px; border-top: 1px solid rgba(128,128,128,0.1); display: flex; gap: 8px;">
        <form method="POST" action="/empleados/horarios/<%= h.id %>/toggle" style="margin:0; flex: 1;">
          <button type="submit" class="btn btn-sm <%= h.activo ? 'btn-warning' : 'btn-success' %>" style="width: 100%; justify-content: center;">
            <%= h.activo ? 'Desactivar' : 'Activar' %>
          </button>
        </form>
        <form method="POST" action="/empleados/horarios/<%= h.id %>/delete" style="margin:0" data-confirm="¿Eliminar este horario?">
          <button type="submit" class="btn btn-sm btn-danger" title="Eliminar" style="width: 40px; justify-content: center; padding: 0;"><i data-lucide="trash-2" style="width:16px;"></i></button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

<style>
  .expandable-form.visible { display: block !important; animation: fadeIn 0.3s; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
  function filtrarHorarios() {
    const filtro = document.getElementById('filter-empleado').value;
    const cards = document.querySelectorAll('.horario-card');
    
    cards.forEach(card => {
      if (filtro === 'ALL' || card.getAttribute('data-empleado') === filtro) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>

<%- include('partials/footer') %>