<%- include('partials/header') %>
<div class="top-bar">
  <h1>Historial de Atenciones</h1>
</div>

<% if (pendientes.length > 0) { %>
<h3 style="margin-bottom:12px">Registrar Servicio Realizado (citas completadas pendientes)</h3>
<form method="POST" action="/historial" class="form-grid">
  <div class="field"><label>Cita completada *</label>
    <select name="id_cita" required>
      <option value="">—</option>
      <% pendientes.forEach(p => { %>
      <option value="<%= p.id %>"><%= p.cliente %> — <%= p.fecha %> <%= p.hora %> (<%= p.servicios %>)</option>
      <% }) %>
    </select>
  </div>
  <div class="field"><label>Empleado</label>
    <select name="id_empleado">
      <option value="">—</option>
      <% empleados.forEach(e => { %>
      <option value="<%= e.id %>"><%= e.nombre %></option>
      <% }) %>
    </select>
  </div>
  <div class="field"><label>Monto</label><input name="monto" type="number" step="0.01" min="0" placeholder="Usa precio del servicio si se omite"></div>
  <div class="field" style="grid-column:1/-1"><label>Notas</label><textarea name="notas" rows="2"></textarea></div>
  <div class="field" style="align-self:end"><button type="submit" class="btn btn-primary">Registrar</button></div>
</form>
<% } %>

<h3 style="margin:<%= pendientes.length > 0 ? '24' : '0' %>px 0 12px">Atenciones Realizadas</h3>
<table>
  <thead><tr><th>Fecha</th><th>Cliente</th><th>Servicio</th><th>Sucursal</th><th>Empleado</th><th>Monto</th><th>Notas</th><th>Acciones</th></tr></thead>
  <tbody>
    <% if (historial.length === 0) { %>
    <tr><td colspan="8" class="empty">Sin atenciones registradas</td></tr>
    <% } %>
    <% historial.forEach(h => { %>
    <tr>
      <td><%= h.fecha %></td>
      <td><%= h.cliente || '—' %></td>
      <td><%= h.servicio %></td>
      <td><%= h.sucursal %></td>
      <td><%= h.empleado || '—' %></td>
      <td>$<%= Number(h.monto).toFixed(2) %></td>
      <td><%= h.notas || '—' %></td>
      <td>
        <form method="POST" action="/historial/<%= h.id %>/delete" style="display:inline" data-confirm="¿Eliminar este registro?">
          <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/footer') %>