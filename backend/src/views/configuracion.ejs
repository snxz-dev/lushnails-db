<%- include('partials/header') %>
<div class="top-bar">
  <h1>Configuración</h1>
</div>

<form method="POST" action="/configuracion" class="form-grid" style="display:flex;flex-direction:column;gap:12px">
  <% configs.forEach(c => { %>
  <div class="field">
    <label><%= c.clave.replace(/_/g, ' ') %></label>
    <input name="<%= c.clave %>" value="<%= c.valor %>" style="width:100%">
    <% if (c.descripcion) { %><small style="color:#999"><%= c.descripcion %></small><% } %>
  </div>
  <% }) %>
  <div><button type="submit" class="btn btn-primary">Guardar Cambios</button></div>
</form>

<% if (user && (user.rol === 'admin' || user.rol === 'superadmin')) { %>
<form method="POST" action="/configuracion/clear-test-data" onsubmit="return confirm('¿Seguro? Esto eliminará clientes y citas de prueba.');" style="margin-top:20px">
  <button type="submit" class="btn btn-danger">Eliminar datos de prueba</button>
</form>
<% } %>

<% if (typeof message !== 'undefined') { %>
  <div class="alert alert-success" style="margin-top:12px"><%= message %></div>
<% } %>
<% if (typeof error !== 'undefined') { %>
  <div class="alert alert-danger" style="margin-top:12px"><%= error %></div>
<% } %>

<%- include('partials/footer') %>
