<%- include('partials/header') %>
<div class="top-bar">
  <h1><i data-lucide="settings"></i> Configuración del Sistema</h1>
</div>

<% if (typeof message !== 'undefined') { %>
  <div style="background: rgba(40,167,69,0.15); border: 1px solid rgba(40,167,69,0.3); color: #28a745; padding: 16px; border-radius: 8px; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
    <i data-lucide="check-circle" style="width: 20px;"></i> <%= message %>
  </div>
<% } %>
<% if (typeof error !== 'undefined') { %>
  <div style="background: rgba(220,53,69,0.15); border: 1px solid rgba(220,53,69,0.3); color: #dc3545; padding: 16px; border-radius: 8px; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
    <i data-lucide="alert-circle" style="width: 20px;"></i> <%= error %>
  </div>
<% } %>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;" class="settings-layout">

  <!-- Columna Izquierda: Parámetros Generales -->
  <div style="display: flex; flex-direction: column; gap: 16px;">
    <div style="background: var(--surface); border-radius: 12px; border: 1px solid rgba(128,128,128,0.2); overflow: hidden;">
      <div style="padding: 16px 24px; background: rgba(128,128,128,0.05); border-bottom: 1px solid rgba(128,128,128,0.2);">
        <h3 style="margin: 0; display: flex; align-items: center; gap: 8px; font-size: 1.1rem;"><i data-lucide="sliders" style="color: var(--primary);"></i> Parámetros Generales</h3>
      </div>
      
      <div style="padding: 24px;">
        <form method="POST" action="/configuracion" class="form-grid" style="box-shadow: none; border: none; padding: 0; margin: 0; background: transparent; display: flex; flex-direction: column; gap: 20px;">
          <% configs.forEach(c => { %>
            <div class="field" style="margin-bottom: 0;">
              <label style="font-weight: 500; font-size: 0.95rem; text-transform: capitalize;"><%= c.clave.replace(/_/g, ' ') %></label>
              <input name="<%= c.clave %>" value="<%= c.valor %>" class="input-modern" style="width: 100%;">
              <% if (c.descripcion) { %>
                <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 4px; display: block;"><i data-lucide="info" style="width: 12px; display: inline;"></i> <%= c.descripcion %></small>
              <% } %>
            </div>
          <% }) %>
          
          <div style="border-top: 1px solid rgba(128,128,128,0.1); padding-top: 20px; display: flex; justify-content: flex-end;">
            <button type="submit" class="btn btn-primary" style="padding: 12px 24px;"><i data-lucide="save"></i> Guardar Cambios</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Columna Derecha: Danger Zone -->
  <div style="display: flex; flex-direction: column; gap: 16px;">
    <% if (user && (user.rol === 'admin' || user.rol === 'superadmin')) { %>
      <div style="border-radius: 12px; border: 1px solid rgba(220,53,69,0.3); overflow: hidden; background: rgba(220,53,69,0.02);">
        <div style="padding: 16px 24px; border-bottom: 1px solid rgba(220,53,69,0.2);">
          <h3 style="margin: 0; display: flex; align-items: center; gap: 8px; color: #dc3545; font-size: 1.1rem;"><i data-lucide="alert-triangle"></i> Zona de Peligro</h3>
        </div>
        
        <div style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
          <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted); line-height: 1.5;">
            Las siguientes acciones son destructivas y no se pueden deshacer. Procede con precaución.
          </p>
          
          <div style="padding: 16px; border: 1px solid rgba(220,53,69,0.2); border-radius: 8px; display: flex; flex-direction: column; gap: 12px; background: var(--surface);">
            <div>
              <strong style="color: var(--text); display: block; font-size: 0.95rem;">Purgar Base de Datos</strong>
              <small style="color: var(--text-muted);">Elimina permanentemente clientes y citas de prueba del sistema.</small>
            </div>
            
            <form method="POST" action="/configuracion/clear-test-data" onsubmit="return confirm('ATENCIÓN: ¿Estás 100% seguro? Esto eliminará de forma irreversible los clientes y citas de prueba.');" style="margin: 0;">
              <button type="submit" class="btn btn-danger" style="width: 100%; justify-content: center; padding: 12px;">Limpiar Datos de Prueba</button>
            </form>
          </div>
        </div>
      </div>
    <% } %>
  </div>

</div>

<style>
  @media (max-width: 900px) {
    .settings-layout { grid-template-columns: 1fr !important; }
  }
</style>

<%- include('partials/footer') %>
