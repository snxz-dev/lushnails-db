<%- include('partials/header') %>
<div class="top-bar"><h1>🌿 Portal Empresarial - Lush Nails Spa</h1></div>

<div style="background:#2F4A34;color:white;padding:30px;border-radius:8px;margin-bottom:30px;text-align:center">
  <h2 style="color:white;font-size:2rem;margin-bottom:8px">LUSH NAILS SPA</h2>
  <p style="color:#A7B8A0;font-style:italic">"Elegancia en cada detalle"</p>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:30px">
  <div style="background:white;padding:24px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
    <h3 style="color:#2F4A34;font-size:1rem;margin-bottom:8px">Misión</h3>
    <p style="font-size:0.85rem;line-height:1.7"><%= config.mision %></p>
  </div>
  <div style="background:white;padding:24px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
    <h3 style="color:#2F4A34;font-size:1rem;margin-bottom:8px">Visión</h3>
    <p style="font-size:0.85rem;line-height:1.7"><%= config.vision %></p>
  </div>
  <div style="background:white;padding:24px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
    <h3 style="color:#2F4A34;font-size:1rem;margin-bottom:8px">Objetivo General</h3>
    <p style="font-size:0.85rem;line-height:1.7"><%= config.objetivo_general %></p>
  </div>
</div>

<h2 style="margin-bottom:20px">📊 Balanced Scorecard</h2>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-bottom:30px">
  <div style="background:white;padding:20px;border-radius:8px;border-top:4px solid #2F4A34;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
    <h3 style="font-size:0.9rem;margin-bottom:12px">💰 Financiera</h3>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Ingresos del mes:</strong> $<%= Number(kpi.ingresos_mensuales).toFixed(2) %></p>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Ingresos totales:</strong> $<%= Number(kpi.ingresos_totales).toFixed(2) %></p>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Ticket promedio:</strong> $<%= Number(kpi.ticket_promedio).toFixed(2) %></p>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Servicios activos:</strong> <%= kpi.total_servicios %></p>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Sucursales operando:</strong> <%= kpi.sucursales_activas %></p>
  </div>
  <div style="background:white;padding:20px;border-radius:8px;border-top:4px solid #5E7F5E;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
    <h3 style="font-size:0.9rem;margin-bottom:12px">👥 Clientes</h3>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Total clientes:</strong> <%= kpi.total_clientes %></p>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Citas últimos 30 días:</strong> <%= kpi.citas_30dias %></p>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Citas pendientes:</strong> <%= kpi.citas_pendientes %></p>
  </div>
  <div style="background:white;padding:20px;border-radius:8px;border-top:4px solid #A7B8A0;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
    <h3 style="font-size:0.9rem;margin-bottom:12px">⚙️ Procesos Internos</h3>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Categorías:</strong> <%= serviciosXcategoria.length %></p>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Galería activa:</strong> <%= kpi.total_galeria %> imágenes</p>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Citas canceladas:</strong> <%= kpi.citas_canceladas %></p>
  </div>
  <div style="background:white;padding:20px;border-radius:8px;border-top:4px solid #BFA78C;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
    <h3 style="font-size:0.9rem;margin-bottom:12px">📚 Aprendizaje y Crecimiento</h3>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Postulaciones recibidas:</strong> <%= kpi.total_postulaciones %></p>
    <p style="font-size:0.85rem;margin:6px 0"><strong>Servicios por categoría:</strong></p>
    <ul style="font-size:0.8rem;padding-left:16px">
      <% serviciosXcategoria.forEach(c => { %>
      <li><%= c.label || c.nombre.toUpperCase() %>: <%= c.total %> servicios</li>
      <% }) %>
    </ul>
  </div>
</div>

<h2 style="margin-bottom:15px">📈 Indicadores por Perspectiva</h2>
<table>
  <thead><tr><th>Perspectiva</th><th>Indicador</th><th>Valor Actual</th><th>Estándar</th><th>Estado</th></tr></thead>
  <tbody>
    <tr><td>Financiera</td><td>Ingresos mensuales</td><td>$<%= Number(kpi.ingresos_mensuales).toFixed(2) %></td><td>&gt; $500</td><td><span class="badge <%= kpi.ingresos_mensuales >= 500 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.ingresos_mensuales >= 500 ? 'Cumple' : 'Mejorable' %></span></td></tr>
    <tr><td>Financiera</td><td>Ticket promedio</td><td>$<%= Number(kpi.ticket_promedio).toFixed(2) %></td><td>≥ $40</td><td><span class="badge <%= kpi.ticket_promedio >= 40 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.ticket_promedio >= 40 ? 'Cumple' : 'Mejorable' %></span></td></tr>
    <tr><td>Financiera</td><td>Servicios activos</td><td><%= kpi.total_servicios %></td><td>≥ 30</td><td><span class="badge <%= kpi.total_servicios >= 30 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.total_servicios >= 30 ? 'Cumple' : 'Mejorable' %></span></td></tr>
    <tr><td>Financiera</td><td>Sucursales operativas</td><td><%= kpi.sucursales_activas %></td><td>≥ 3</td><td><span class="badge <%= kpi.sucursales_activas >= 3 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.sucursales_activas >= 3 ? 'Cumple' : 'Mejorable' %></span></td></tr>
    <tr><td>Financiera</td><td>Citas completadas</td><td><%= kpi.citas_completadas %></td><td>≥ 10</td><td><span class="badge <%= kpi.citas_completadas >= 10 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.citas_completadas >= 10 ? 'Cumple' : 'Mejorable' %></span></td></tr>
    <tr><td>Clientes</td><td>Clientes registrados</td><td><%= kpi.total_clientes %></td><td>≥ 10</td><td><span class="badge <%= kpi.total_clientes >= 10 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.total_clientes >= 10 ? 'Cumple' : 'Mejorable' %></span></td></tr>
    <tr><td>Clientes</td><td>Citas últimas 30 días</td><td><%= kpi.citas_30dias %></td><td>≥ 5</td><td><span class="badge <%= kpi.citas_30dias >= 5 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.citas_30dias >= 5 ? 'Cumple' : 'Mejorable' %></span></td></tr>
    <tr><td>Procesos</td><td>Galería activa</td><td><%= kpi.total_galeria %></td><td>≥ 5</td><td><span class="badge <%= kpi.total_galeria >= 5 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.total_galeria >= 5 ? 'Cumple' : 'Mejorable' %></span></td></tr>
    <tr><td>Procesos</td><td>Citas canceladas</td><td><%= kpi.citas_canceladas %></td><td>≤ 2</td><td><span class="badge <%= kpi.citas_canceladas <= 2 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.citas_canceladas <= 2 ? 'Cumple' : 'Mejorable' %></span></td></tr>
    <tr><td>Aprendizaje</td><td>Postulaciones recibidas</td><td><%= kpi.total_postulaciones %></td><td>≥ 1</td><td><span class="badge <%= kpi.total_postulaciones >= 1 ? 'badge-true' : 'badge-mejorable' %>"><%= kpi.total_postulaciones >= 1 ? 'Cumple' : 'Mejorable' %></span></td></tr>
  </tbody>
</table>

<h2 style="margin:30px 0 15px">💰 Rentabilidad por Servicio</h2>
<table>
  <thead><tr><th>Servicio</th><th>Atenciones</th><th>Ingresos</th><th>Precio lista</th><th>Margen</th></tr></thead>
  <tbody>
    <% if (rentabilidadXservicio.length === 0) { %>
    <tr><td colspan="5" class="empty">Aún no hay servicios realizados registrados (módulo Historial)</td></tr>
    <% } %>
    <% rentabilidadXservicio.forEach(r => { %>
    <tr>
      <td><%= r.servicio %></td>
      <td><%= r.atenciones %></td>
      <td>$<%= Number(r.ingresos).toFixed(2) %></td>
      <td>$<%= Number(r.precio_lista).toFixed(2) %></td>
      <td>$<%= Number(r.margen).toFixed(2) %></td>
    </tr>
    <% }) %>
  </tbody>
</table>

<h2 style="margin:40px 0 20px">📈 Análisis Gráfico de Citas</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(400px, 1fr));gap:25px;margin-bottom:40px">
  
  <div style="background:var(--surface);padding:30px;border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.05);">
    <h3 style="margin-bottom: 20px; color: var(--primary); text-align:center;">Citas por Mes (Últimos 6 meses)</h3>
    <div style="height: 250px; width: 100%;">
      <canvas id="citasMesChart"></canvas>
    </div>
  </div>

  <div style="background:var(--surface);padding:30px;border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.05);">
    <h3 style="margin-bottom: 20px; color: var(--primary); text-align:center;">Distribución por Estado</h3>
    <div style="height: 250px; width: 100%; display: flex; justify-content: center;">
      <canvas id="citasEstadoChart"></canvas>
    </div>
  </div>

</div>

<!-- Datos inyectados para el script -->
<div id="bsc-data" 
     data-citas-mes="<%= JSON.stringify(citasXmes) %>" 
     data-citas-estado="<%= JSON.stringify(citasXestado) %>"
     style="display:none;"></div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    
    // Leer los datos del DOM
    const rawMes = document.getElementById('bsc-data').getAttribute('data-citas-mes');
    const rawEstado = document.getElementById('bsc-data').getAttribute('data-citas-estado');
    const citasMes = JSON.parse(rawMes);
    const citasEstado = JSON.parse(rawEstado);

    // 1. Gráfico de Línea: Citas por Mes
    if (citasMes.length > 0) {
      const ctxMes = document.getElementById('citasMesChart').getContext('2d');
      new Chart(ctxMes, {
        type: 'line',
        data: {
          labels: citasMes.map(item => item.mes),
          datasets: [{
            label: 'Total Citas',
            data: citasMes.map(item => parseInt(item.total)),
            borderColor: 'rgba(47, 74, 52, 1)',
            backgroundColor: 'rgba(47, 74, 52, 0.1)',
            borderWidth: 2,
            fill: true,
            tension: 0.3,
            pointBackgroundColor: 'rgba(47, 74, 52, 1)',
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
      });
    }

    // 2. Gráfico de Dona: Estados de las Citas
    if (citasEstado.length > 0) {
      const ctxEstado = document.getElementById('citasEstadoChart').getContext('2d');
      
      // Mapear colores dependiendo del estado
      const colorMap = {
        'pendiente': 'rgba(245, 158, 11, 0.8)',
        'confirmada': 'rgba(16, 185, 129, 0.8)',
        'completada': 'rgba(59, 130, 246, 0.8)',
        'cancelada': 'rgba(239, 68, 68, 0.8)'
      };
      
      const backgroundColors = citasEstado.map(item => colorMap[item.estado] || 'rgba(156, 163, 175, 0.8)');

      new Chart(ctxEstado, {
        type: 'pie',
        data: {
          labels: citasEstado.map(item => item.estado.toUpperCase()),
          datasets: [{
            data: citasEstado.map(item => parseInt(item.total)),
            backgroundColor: backgroundColors,
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right' }
          }
        }
      });
    }

  });
</script>

<%- include('partials/footer') %>
