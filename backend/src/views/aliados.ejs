<%- include('partials/header') %>
<div class="top-bar">
  <h1><i data-lucide="users"></i> Aliados Estratégicos</h1>
</div>

<div class="controls-bar" style="display: flex; justify-content: flex-end; margin-bottom: 24px;">
  <button class="btn btn-primary" onclick="document.getElementById('form-aliado').classList.toggle('visible')">
    <i data-lucide="user-plus"></i> Nuevo Aliado
  </button>
</div>

<div id="form-aliado" class="expandable-form" style="display: none; background: var(--surface); padding: 24px; border-radius: 12px; border: 1px solid rgba(128,128,128,0.2); margin-bottom: 32px;">
  <h3 style="margin-bottom: 16px; border-bottom: 1px solid rgba(128,128,128,0.2); padding-bottom: 8px;">Registrar Aliado</h3>
  <form method="POST" action="/aliados" class="form-grid" style="box-shadow: none; border: none; padding: 0; margin: 0; background: transparent;">
    <div class="field"><label>Nombre del Aliado *</label><input name="nombre" required placeholder="Ej: Influencer, Marca..."></div>
    <div class="field"><label>Teléfono</label><input name="telefono"></div>
    <div class="field"><label>Correo</label><input name="correo" type="email"></div>
    <div class="field"><label>WhatsApp Link</label><input name="link_whatsapp" placeholder="https://wa.me/..."></div>
    <div class="field"><label>Dirección</label><input name="direccion"></div>
    <div class="field"><label>Sitio Web</label><input name="sitio_web" placeholder="https://"></div>
    <div class="field" style="grid-column:1/-1"><label>Descripción o Notas</label><textarea name="descripcion" rows="2" class="input-modern"></textarea></div>
    
    <div class="field" style="grid-column: 1 / -1; display:flex; gap:8px; justify-content: flex-end; margin-top: 8px;">
      <button type="button" class="btn" style="background:transparent; border:1px solid var(--text-muted); color:var(--text);" onclick="document.getElementById('form-aliado').classList.remove('visible')">Cancelar</button>
      <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Guardar Aliado</button>
    </div>
  </form>
</div>

<!-- Tarjetas de Aliados (Kanban Style) -->
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
  <% if (aliados.length === 0) { %>
    <div class="empty" style="grid-column: 1 / -1; padding: 48px; background: var(--surface); border-radius: 12px; border: 1px solid rgba(128,128,128,0.2);">Sin aliados registrados</div>
  <% } %>
  
  <% aliados.forEach(a => { %>
    <div class="aliado-card <%= !a.activo ? 'inactive' : '' %>" style="background: var(--surface); border-radius: 12px; border: 1px solid rgba(128,128,128,0.2); overflow: hidden; display: flex; flex-direction: column;">
      
      <div style="padding: 16px; background: rgba(128,128,128,0.05); border-bottom: 1px solid rgba(128,128,128,0.1); display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(a.nombre) %>&background=random&color=fff&size=40" alt="Avatar" style="border-radius: 8px; width: 40px; height: 40px;">
          <div>
            <h4 style="margin: 0; color: var(--primary); font-size: 1.05rem;"><%= a.nombre %></h4>
            <span style="font-size: 0.8rem; color: var(--text-muted);"><%= a.activo ? 'Aliado Estratégico' : 'Alianza Inactiva' %></span>
          </div>
        </div>
        <span class="badge badge-<%= a.activo %>" style="font-size: 0.7rem;"><%= a.activo ? 'Activo' : 'Inactivo' %></span>
      </div>
      
      <div style="padding: 16px; flex: 1; display: flex; flex-direction: column; gap: 12px;">
        <% if (a.descripcion) { %>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0; padding-bottom: 12px; border-bottom: 1px solid rgba(128,128,128,0.1);"><%= a.descripcion %></p>
        <% } %>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.85rem;">
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <% if (a.telefono) { %>
              <a href="tel:<%= a.telefono %>" style="color: var(--text); text-decoration: none; display: flex; align-items: center; gap: 6px;"><i data-lucide="phone" style="width: 14px; color: var(--primary);"></i> <%= a.telefono %></a>
            <% } %>
            <% if (a.correo) { %>
              <a href="mailto:<%= a.correo %>" style="color: var(--text); text-decoration: none; display: flex; align-items: center; gap: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><i data-lucide="mail" style="width: 14px; color: var(--primary);"></i> <%= a.correo %></a>
            <% } %>
          </div>
          
          <div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-end;">
            <% if (a.link_whatsapp) { %>
              <a href="<%= a.link_whatsapp %>" target="_blank" style="color: #25D366; text-decoration: none; display: flex; align-items: center; gap: 6px; font-weight: 500;"><i data-lucide="message-circle" style="width: 14px;"></i> WhatsApp</a>
            <% } %>
            <% if (a.sitio_web) { %>
              <a href="<%= a.sitio_web %>" target="_blank" style="color: var(--primary); text-decoration: none; display: flex; align-items: center; gap: 6px; font-weight: 500;"><i data-lucide="globe" style="width: 14px;"></i> Website</a>
            <% } %>
          </div>
        </div>
      </div>
      
      <div style="padding: 12px 16px; border-top: 1px solid rgba(128,128,128,0.1); display: flex; gap: 8px;">
        <form method="POST" action="/aliados/<%= a.id %>/toggle" style="margin:0; flex: 1;">
          <button type="submit" class="btn btn-sm <%= a.activo ? 'btn-warning' : 'btn-success' %>" style="width: 100%; justify-content: center;">
            <i data-lucide="<%= a.activo ? 'power-off' : 'power' %>" style="width: 14px;"></i> <%= a.activo ? 'Desactivar' : 'Activar' %>
          </button>
        </form>
        <form method="POST" action="/aliados/<%= a.id %>/delete" style="margin:0" data-confirm="¿Eliminar a este aliado permanentemente?">
          <button type="submit" class="btn btn-sm btn-danger" title="Eliminar" style="width: 40px; justify-content: center; padding: 0;"><i data-lucide="trash-2" style="width:16px;"></i></button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

<style>
  .expandable-form.visible { display: block !important; animation: fadeIn 0.3s; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
  .aliado-card { transition: transform 0.2s, box-shadow 0.2s; }
  .aliado-card:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.15); }
  .aliado-card.inactive { opacity: 0.6; filter: grayscale(50%); }
</style>

<%- include('partials/footer') %>
