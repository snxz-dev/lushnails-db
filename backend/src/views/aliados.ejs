<%- include('partials/header') %>
<div class="top-bar">
  <h1>Aliados</h1>
</div>

<form method="POST" action="/aliados" class="form-grid">
  <div class="field"><label>Nombre *</label><input name="nombre" required></div>
  <div class="field"><label>Teléfono</label><input name="telefono"></div>
  <div class="field"><label>Correo</label><input name="correo" type="email"></div>
  <div class="field"><label>WhatsApp Link</label><input name="link_whatsapp"></div>
  <div class="field"><label>Dirección</label><input name="direccion"></div>
  <div class="field"><label>Sitio Web</label><input name="sitio_web" placeholder="https://"></div>
  <div class="field" style="grid-column:1/-1"><label>Descripción</label><textarea name="descripcion" rows="2"></textarea></div>
  <div class="field" style="align-self:end"><button type="submit" class="btn btn-primary">Agregar</button></div>
</form>

<table>
  <thead><tr><th>Nombre</th><th>Teléfono</th><th>WhatsApp</th><th>Sitio Web</th><th>Activo</th><th>Acciones</th></tr></thead>
  <tbody>
    <% if (aliados.length === 0) { %>
    <tr><td colspan="6" class="empty">Sin aliados registrados</td></tr>
    <% } %>
    <% aliados.forEach(a => { %>
    <tr>
      <td><%= a.nombre %></td>
      <td><%= a.telefono || '—' %></td>
      <td><%= a.link_whatsapp ? '✅' : '—' %></td>
      <td><%= a.sitio_web ? '✅' : '—' %></td>
      <td><span class="badge badge-<%= a.activo %>"><%= a.activo ? 'Sí' : 'No' %></span></td>
      <td>
        <form method="POST" action="/aliados/<%= a.id %>/toggle" style="display:inline">
          <button type="submit" class="btn btn-sm <%= a.activo ? 'btn-warning' : 'btn-success' %>">
            <%= a.activo ? 'Desactivar' : 'Activar' %>
          </button>
        </form>
        <form method="POST" action="/aliados/<%= a.id %>/delete" style="display:inline" data-confirm="¿Eliminar este aliado?">
          <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/footer') %>
