<%- include('partials/header') %>
<div class="top-bar">
  <h1>Clientes</h1>
</div>

<h3 style="margin-bottom:12px">Registrar Cliente y Cita</h3>
<form method="POST" action="/clientes" class="form-grid">
  <div class="field"><label>Nombre</label><input name="nombre" required></div>
  <div class="field"><label>Teléfono</label><input name="telefono" required></div>
  <div class="field"><label>Correo</label><input name="correo" type="email"></div>
  <div class="field"><label>Dirección</label><input name="direccion"></div>
  <div class="field"><label>Alergias</label><input name="alergias"></div>
  <div class="field"><label>Notas</label><input name="notas"></div>
  <div class="field"><label>Sucursal</label>
    <select name="id_sucursal">
      <option value="">— Sin cita —</option>
      <% sucursales.forEach(s => { %>
      <option value="<%= s.id %>"><%= s.nombre %></option>
      <% }) %>
    </select>
  </div>
  <div class="field"><label>Servicio</label>
    <select name="id_servicio">
      <option value="">—</option>
      <% servicios.forEach(s => { %>
      <option value="<%= s.id %>"><%= s.nombre %></option>
      <% }) %>
    </select>
  </div>
  <div class="field"><label>Fecha</label><input name="fecha" id="cita-fecha" type="date"></div>
  <div class="field" id="cita-grid-field" style="display:none">
    <label>Hora disponible (solo horas libres)</label>
    <div id="cita-slots" class="slots-grid-admin"></div>
    <input type="hidden" name="hora" id="cita-hora">
  </div>
  <div class="field" style="align-self:end"><button type="submit" class="btn btn-primary">Registrar</button></div>
</form>

<script>
(function () {
  var fecha = document.getElementById('cita-fecha');
  var suc = document.querySelector('select[name="id_sucursal"]');
  var serv = document.querySelector('select[name="id_servicio"]');
  var field = document.getElementById('cita-grid-field');
  var slots = document.getElementById('cita-slots');
  var horaHidden = document.getElementById('cita-hora');

  function cargar() {
    horaHidden.value = '';
    if (!fecha.value || !suc.value || !serv.value) { field.style.display = 'none'; return; }
    field.style.display = 'block';
    slots.innerHTML = '<span class="slots-msg-admin">Cargando horarios…</span>';
    fetch('/api/disponibilidad?fecha=' + fecha.value + '&id_sucursal=' + suc.value + '&servicios=' + serv.value)
      .then(function (r) { return r.json(); })
      .then(function (data) {
        slots.innerHTML = '';
        data.slots.forEach(function (s) {
          var b = document.createElement('button');
          b.type = 'button';
          b.textContent = s.hora;
          b.className = s.ocupado ? 'slot-admin slot-ocupado' : 'slot-admin';
          b.disabled = s.ocupado;
          b.title = s.ocupado ? 'Ocupado' : 'Disponible';
          if (!s.ocupado) {
            b.onclick = function () {
              slots.querySelectorAll('.slot-admin').forEach(function (x) { x.classList.remove('slot-selected'); });
              b.classList.add('slot-selected');
              horaHidden.value = s.hora;
            };
          }
          slots.appendChild(b);
        });
      })
      .catch(function () {
        slots.innerHTML = '<span class="slots-msg-admin">Error al consultar disponibilidad</span>';
      });
  }

  fecha.addEventListener('change', cargar);
  suc.addEventListener('change', cargar);
  serv.addEventListener('change', cargar);
})();
</script>

<h3 style="margin:24px 0 12px">Clientes Existentes</h3>
<table>
  <thead><tr><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Citas</th><th>Última visita</th><th>Activo</th><th>Acciones</th></tr></thead>
  <tbody>
    <% if (clientes.length === 0) { %>
    <tr><td colspan="7" class="empty">Sin clientes registrados</td></tr>
    <% } %>
    <% clientes.forEach(c => { %>
    <tr>
      <td><%= c.nombre %></td>
      <td><%= c.telefono %></td>
      <td><%= c.correo || '-' %></td>
      <td><%= c.total_citas %></td>
      <td><%= c.ultima_visita || '-' %></td>
      <td><span class="badge badge-<%= c.activo %>"><%= c.activo ? 'Sí' : 'No' %></span></td>
      <td>
        <form method="POST" action="/clientes/<%= c.id %>/toggle" style="display:inline">
          <button type="submit" class="btn btn-sm <%= c.activo ? 'btn-warning' : 'btn-success' %>">
            <%= c.activo ? 'Desactivar' : 'Activar' %>
          </button>
        </form>
        <form method="POST" action="/clientes/<%= c.id %>/delete" style="display:inline" data-confirm="¿Eliminar este cliente y sus citas?">
          <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/footer') %>
