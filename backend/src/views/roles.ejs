<%- include('partials/header') %>
<div class="top-bar">
  <h1>Gestión de Usuarios y Roles</h1>
</div>

<h3 style="margin-bottom:12px">Nuevo Usuario</h3>
<form method="POST" action="/roles" class="form-grid">
  <div class="field"><label>Nombre</label><input name="nombre" required></div>
  <div class="field"><label>Email</label><input name="email" type="email" required></div>
  <div class="field"><label>Contraseña</label><input name="password" type="password" required></div>
  <div class="field"><label>Rol</label>
    <select name="rol" required>
      <% roles.forEach(r => { %>
      <option value="<%= r.codigo %>"><%= r.nombre %></option>
      <% }) %>
    </select>
  </div>
  <div class="field" style="align-self:end"><button type="submit" class="btn btn-primary">Agregar</button></div>
</form>

<h3 style="margin:24px 0 12px">Usuarios Existentes</h3>
<table>
  <thead><tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Activo</th><th>Creado</th><th>Acciones</th></tr></thead>
  <tbody>
    <% if (usuarios.length === 0) { %>
    <tr><td colspan="6" class="empty">Sin usuarios registrados</td></tr>
    <% } %>
    <% usuarios.forEach(u => { %>
    <tr>
      <td><%= u.nombre %></td>
      <td><%= u.email %></td>
      <td>
        <form method="POST" action="/roles/<%= u.id %>/rol" style="display:inline">
          <select name="rol" onchange="this.form.submit()">
            <% roles.forEach(r => { %>
            <option value="<%= r.codigo %>" <%= u.rol === r.codigo ? 'selected' : '' %>><%= r.nombre %></option>
            <% }) %>
          </select>
        </form>
      </td>
      <td><span class="badge badge-<%= u.activo %>"><%= u.activo ? 'Sí' : 'No' %></span></td>
      <td><%= u.created_at ? new Date(u.created_at).toLocaleDateString() : '-' %></td>
      <td>
        <% if (u.email !== 'demo-admin@lushnails.example') { %>
        <form method="POST" action="/roles/<%= u.id %>/toggle" style="display:inline">
          <button type="submit" class="btn btn-sm <%= u.activo ? 'btn-warning' : 'btn-success' %>">
            <%= u.activo ? 'Desactivar' : 'Activar' %>
          </button>
        </form>
        <form method="POST" action="/roles/<%= u.id %>/delete" style="display:inline" data-confirm="¿Eliminar este usuario?">
          <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
        </form>
        <% } else { %>
        <span class="empty">principal</span>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<h3 style="margin:24px 0 12px">Permisos por Rol</h3>
<table>
  <thead><tr><th>Rol</th><th>Permisos asignados</th></tr></thead>
  <tbody>
    <% roles.forEach(r => { %>
    <tr>
      <td><strong><%= r.nombre %></strong><br><small class="empty"><%= r.descripcion %></small></td>
      <td>
        <% const perms = permisosPorRol[r.id] || []; %>
        <% if (perms.length === 0) { %>
        <span class="empty">Sin permisos asignados</span>
        <% } else { %>
        <% perms.forEach(p => { %>
        <span class="badge badge-permiso"><%= p %></span>
        <% }) %>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/footer') %>
