<%- include('partials/header') %>
<div class="top-bar">
  <h1><i data-lucide="package"></i> Gestión de Proveedores</h1>
</div>

<div class="controls-bar" style="display: flex; justify-content: flex-end; margin-bottom: 24px;">
  <button class="btn btn-primary" onclick="document.getElementById('form-proveedor').classList.toggle('visible')">
    <i data-lucide="truck"></i> Nuevo Proveedor
  </button>
</div>

<div id="form-proveedor" class="expandable-form" style="display: none; background: var(--surface); padding: 24px; border-radius: 12px; border: 1px solid rgba(128,128,128,0.2); margin-bottom: 32px;">
  <h3 style="margin-bottom: 16px; border-bottom: 1px solid rgba(128,128,128,0.2); padding-bottom: 8px;">Registrar Proveedor</h3>
  <form method="POST" action="/proveedores" class="form-grid" style="box-shadow: none; border: none; padding: 0; margin: 0; background: transparent;">
    <div class="field"><label>Nombre Empresa *</label><input name="nombre" required></div>
    <div class="field"><label>Contacto (Persona)</label><input name="contacto" placeholder="Persona de contacto"></div>
    <div class="field"><label>Teléfono</label><input name="telefono" placeholder="+123456789"></div>
    <div class="field"><label>Correo</label><input name="correo" type="email" placeholder="ejemplo@correo.com"></div>
    <div class="field"><label>Tipo de Insumo</label><input name="tipo_insumo" placeholder="Ej: Uñas, Cabello, Estética"></div>
    <div class="field"><label>Dirección</label><input name="direccion" placeholder="Dirección física"></div>
    <div class="field" style="grid-column:1/-1"><label>Notas / Observaciones</label><textarea name="notas" rows="2" class="input-modern"></textarea></div>
    
    <div class="field" style="grid-column: 1 / -1; display:flex; gap:8px; justify-content: flex-end; margin-top: 8px;">
      <button type="button" class="btn" style="background:transparent; border:1px solid var(--text-muted); color:var(--text);" onclick="document.getElementById('form-proveedor').classList.remove('visible')">Cancelar</button>
      <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Guardar Proveedor</button>
    </div>
  </form>
</div>

<!-- Data Grid Proveedores -->
<div class="data-grid-container" style="background: var(--surface); border-radius: 12px; border: 1px solid rgba(128,128,128,0.2); overflow: hidden;">
  <table style="margin: 0; width: 100%; border-collapse: collapse;">
    <thead style="background: rgba(128,128,128,0.05); border-bottom: 1px solid rgba(128,128,128,0.2);">
      <tr>
        <th style="padding: 16px; text-align: left; color: var(--text-muted); font-weight: 500;">Proveedor</th>
        <th style="padding: 16px; text-align: left; color: var(--text-muted); font-weight: 500;">Insumo</th>
        <th style="padding: 16px; text-align: left; color: var(--text-muted); font-weight: 500;">Contacto</th>
        <th style="padding: 16px; text-align: center; color: var(--text-muted); font-weight: 500;">Estado</th>
        <th style="padding: 16px; text-align: right; color: var(--text-muted); font-weight: 500;">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (proveedores.length === 0) { %>
        <tr><td colspan="5" class="empty" style="padding: 32px; text-align: center; color: var(--text-muted);">No hay proveedores registrados</td></tr>
      <% } %>
      
      <% proveedores.forEach(p => { %>
        <tr style="border-bottom: 1px solid rgba(128,128,128,0.1); transition: background 0.2s;">
          <!-- Proveedor Info con Avatar -->
          <td style="padding: 16px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(p.nombre) %>&background=random&color=fff&rounded=true" alt="Avatar" style="width: 40px; height: 40px; border-radius: 50%;">
              <div>
                <strong style="color: var(--text); font-size: 1rem; display: block;"><%= p.nombre %></strong>
                <span style="font-size: 0.8rem; color: var(--text-muted);"><i data-lucide="user" style="width: 12px; display: inline;"></i> <%= p.contacto || 'Sin contacto directo' %></span>
              </div>
            </div>
          </td>
          
          <!-- Insumo -->
          <td style="padding: 16px;">
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: rgba(128,128,128,0.1); border-radius: 6px; font-size: 0.85rem; color: var(--text);">
              <i data-lucide="box" style="width: 14px;"></i> <%= p.tipo_insumo || 'General' %>
            </span>
          </td>
          
          <!-- Contacto Rapido -->
          <td style="padding: 16px;">
            <div style="display: flex; flex-direction: column; gap: 4px; font-size: 0.85rem; color: var(--text-muted);">
              <% if (p.telefono) { %>
                <a href="tel:<%= p.telefono %>" style="color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 6px;"><i data-lucide="phone" style="width: 12px;"></i> <%= p.telefono %></a>
              <% } %>
              <% if (p.correo) { %>
                <a href="mailto:<%= p.correo %>" style="color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 6px;"><i data-lucide="mail" style="width: 12px;"></i> <%= p.correo %></a>
              <% } %>
              <% if (!p.telefono && !p.correo) { %>
                <span>—</span>
              <% } %>
            </div>
          </td>
          
          <!-- Estado -->
          <td style="padding: 16px; text-align: center;">
            <span class="badge badge-<%= p.activo %>" style="font-size: 0.75rem;"><%= p.activo ? 'Activo' : 'Inactivo' %></span>
          </td>
          
          <!-- Acciones -->
          <td style="padding: 16px; text-align: right;">
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
              <form method="POST" action="/proveedores/<%= p.id %>/toggle" style="margin: 0;">
                <button type="submit" class="btn btn-sm <%= p.activo ? 'btn-warning' : 'btn-success' %>" title="<%= p.activo ? 'Desactivar' : 'Activar' %>" style="padding: 8px;">
                  <i data-lucide="<%= p.activo ? 'power-off' : 'power' %>" style="width: 16px;"></i>
                </button>
              </form>
              <form method="POST" action="/proveedores/<%= p.id %>/delete" style="margin: 0;" data-confirm="¿Eliminar a <%= p.nombre %> permanentemente?">
                <button type="submit" class="btn btn-sm btn-danger" title="Eliminar" style="padding: 8px;">
                  <i data-lucide="trash-2" style="width: 16px;"></i>
                </button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<style>
  .expandable-form.visible { display: block !important; animation: fadeIn 0.3s; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
  tbody tr:hover { background: rgba(128,128,128,0.03); }
</style>

<%- include('partials/footer') %>
