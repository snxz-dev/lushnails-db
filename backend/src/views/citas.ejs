<%- include('partials/header') %>
<div class="top-bar">
  <h1>Citas</h1>
</div>

<div class="filters-row">
  <form method="GET" action="/citas" style="display:flex;gap:8px;align-items:center">
    <label>Fecha: <input type="date" name="fecha" value="<%= matrix ? (new Date().toISOString().slice(0,10)) : '' %>" /></label>
    <label>Sucursal:
      <select name="id_sucursal">
        <option value="">--Seleccione--</option>
        <% if (sucursales) { sucursales.forEach(s => { %>
          <option value="<%= s.id %>"><%= s.nombre %></option>
        <% }) } %>
      </select>
    </label>
    <button type="submit" class="btn">Ver matriz</button>
  </form>
</div>

<% if (matrix) { %>
  <h3>Matriz de horarios (duración <%= matrix.duracion %> min)</h3>
  <div class="admin-matrix">
    <table class="admin-matrix-table">
      <thead>
        <tr>
          <th>Empleado</th>
          <% matrix.times.forEach(function(t){ %>
            <th><%= t %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% matrix.empleados.forEach(function(emp){ %>
          <tr>
            <td class="emp-name"><%= emp.nombre %></td>
            <% emp.slots.forEach(function(s){ %>
              <td class="emp-cell <%= s.trabaja ? '' : 'emp-off' %>">
                <button class="seat-btn <%= s.ocupado ? 'seat-busy' : s.trabaja ? 'seat-free' : 'seat-off' %>" <%= (!s.trabaja || s.ocupado) ? 'disabled' : '' %> title="<%= s.ocupado && s.detalle ? s.detalle.cliente : '' %>">
                  <%= s.hora %>
                </button>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<table>
  <thead><tr><th>Cliente</th><th>Teléfono</th><th>Sucursal</th><th>Fecha</th><th>Hora</th><th>Servicio</th><th>Estado</th><th>Acciones</th></tr></thead>
  <tbody>
    <% if (citas.length === 0) { %>
    <tr><td colspan="8" class="empty">Sin citas registradas</td></tr>
    <% } %>
    <% citas.forEach(c => { %>
    <tr>
      <td><%= c.cliente %></td>
      <td><%= c.cliente_telefono %></td>
      <td><%= c.sucursal %></td>
      <td><%= c.fecha %></td>
      <td><%= c.hora %></td>
      <td><%= c.servicios %></td>
      <td><span class="badge badge-<%= c.estado %>"><%= c.estado %></span></td>
      <td>
        <form method="POST" action="/citas/<%= c.cita_id %>/estado" style="display:inline">
          <select name="estado" style="padding:4px 8px;font-size:0.75rem">
            <option value="pendiente" <%= c.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
            <option value="confirmada" <%= c.estado === 'confirmada' ? 'selected' : '' %>>Confirmada</option>
            <option value="completada" <%= c.estado === 'completada' ? 'selected' : '' %>>Completada</option>
            <option value="cancelada" <%= c.estado === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
          </select>
          <button type="submit" class="btn btn-sm btn-primary">Actualizar</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/footer') %>
